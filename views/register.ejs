<div class="row justify-content-center">
  <div class="col-lg-6">
    <h2 class="mb-1">Регистрация</h2>
    <p class="text-muted">Выберите, кто вы: семья, нуждающаяся в помощи, или благотворитель.</p>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/register" method="post">
      <div class="mb-3">
        <label class="form-label">Кто вы? *</label>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input class="form-check-input" type="radio" name="role" id="role-family" value="family" <%= values.role === 'benefactor' ? '' : 'checked' %>>
            <label class="form-check-label" for="role-family">Семья (нуждаюсь в помощи)</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="role" id="role-benefactor" value="benefactor" <%= values.role === 'benefactor' ? 'checked' : '' %>>
            <label class="form-check-label" for="role-benefactor">Благотворитель</label>
          </div>
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label">Юзернейм *</label>
        <input type="text" name="username" class="form-control" required maxlength="30" placeholder="Например: mama_anny" value="<%= values.username || '' %>">
        <div class="form-text">3–30 символов: буквы, цифры, символы _ и -</div>
      </div>
      <div class="mb-3">
        <label class="form-label">Пароль *</label>
        <input type="password" name="password" class="form-control" required minlength="4">
      </div>
      <div class="mb-3" id="childrenBlock">
        <label class="form-label">Сколько детей до 18 лет в семье?</label>
        <input type="number" name="childrenCount" class="form-control" min="0" max="20" value="<%= values.childrenCount || '1' %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Коротко о себе / своей семье (необязательно)</label>
        <textarea name="about" class="form-control" rows="3" maxlength="1000" placeholder="Например: одинокая мама троих детей, старшей 7 лет и т.п."><%= values.about || '' %></textarea>
      </div>
      <button type="submit" class="btn btn-primary w-100">Зарегистрироваться</button>
    </form>

    <p class="mt-3 text-muted">Уже есть аккаунт? <a href="/login">Войти</a></p>
  </div>
</div>

<script>
  const roleFamily = document.getElementById('role-family');
  const roleBenefactor = document.getElementById('role-benefactor');
  const block = document.getElementById('childrenBlock');
  function toggleChildren() {
    block.style.display = roleFamily.checked ? '' : 'none';
    if (!roleFamily.checked) block.querySelector('input').value = 0;
  }
  roleFamily.addEventListener('change', toggleChildren);
  roleBenefactor.addEventListener('change', toggleChildren);
  toggleChildren();
</script>