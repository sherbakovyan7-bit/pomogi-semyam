<h2 class="mb-3">Личные сообщения</h2>

<% if (conversations.length === 0) { %>
  <div class="alert alert-light border">
    У вас пока нет диалогов.
    <% if (user.role === 'benefactor') { %>
      Откройте нужду на <a href="/">главной</a> и нажмите «Хочу помочь», чтобы написать семье.
    <% } else { %>
      Когда благотворитель откликнется на вашу нужду, диалог появится здесь.
    <% } %>
  </div>
<% } else { %>
  <div class="list-group">
    <% conversations.forEach(({ conv, need, other, last, unread }) => { %>
      <a href="/chat/<%= conv.id %>" class="list-group-item list-group-item-action d-flex align-items-center gap-3 <%= unread > 0 ? 'unread' : '' %>">
        <div class="avatar bg-primary text-white"><%= (other ? other.name[0] : '?') %></div>
        <div class="flex-grow-1 overflow-hidden">
          <div class="d-flex justify-content-between">
            <strong><%= other ? other.username : 'Удалённый пользователь' %></strong>
            <small class="text-muted text-nowrap"><%= last ? formatDate(last.createdAt) : formatDate(conv.createdAt) %></small>
          </div>
          <div class="small text-muted text-truncate">По нужде: «<%= need ? need.title : 'удалено' %>»</div>
          <div class="small text-truncate">
            <% if (unread > 0) { %><span class="badge bg-danger"><%= unread %> новых</span><% } %>
            <% if (last) { %>
              <%= last.files && last.files.length ? '📎 ' : '' %><%= last.text || 'Вложение' %>
            <% } %>
          </div>
        </div>
      </a>
    <% }); %>
  </div>
<% } %>
