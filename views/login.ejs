<div class="row justify-content-center">
  <div class="col-lg-6">
    <h2 class="mb-3">Вход</h2>
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <form action="/login" method="post">
      <div class="mb-3">
        <label class="form-label">Юзернейм</label>
        <input type="text" name="username" class="form-control" required autocomplete="username" value="<%= values.username || '' %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Пароль</label>
        <input type="password" name="password" class="form-control" required autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn-primary w-100">Войти</button>
    </form>
    <p class="mt-3 text-muted">Нет аккаунта? <a href="/register">Зарегистрируйтесь</a></p>
  </div>
</div>