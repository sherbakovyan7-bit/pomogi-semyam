<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> — ПомогиСемьям</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">
        <span class="badge bg-primary me-1">❤</span> ПомогиСемьям
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="nav">
        <ul class="navbar-nav me-auto">
          <li class="nav-item"><a class="nav-link <%= path === '/' ? 'active' : '' %>" href="/">Нужды</a></li>
          <% if (user) { %>
            <li class="nav-item"><a class="nav-link <%= path === '/messages' ? 'active' : '' %>" href="/messages">Сообщения</a></li>
            <% if (user.role === 'family') { %>
              <li class="nav-item"><a class="nav-link" href="/need/new">Подать нужду</a></li>
            <% } %>
          <% } %>
        </ul>
        <ul class="navbar-nav">
          <% if (user) { %>
            <li class="nav-item d-flex align-items-center me-2">
              <span class="badge <%= user.role === 'benefactor' ? 'bg-success' : 'bg-info' %> me-2"><%= user.role === 'benefactor' ? 'Благотворитель' : 'Семья' %></span>
              <span class="text-muted small me-2"><%= user.username %></span>
            </li>
            <li class="nav-item">
              <form action="/logout" method="post" class="d-inline">
                <button class="btn btn-outline-secondary btn-sm" type="submit">Выйти</button>
              </form>
            </li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link" href="/login">Войти</a></li>
            <li class="nav-item"><a class="btn btn-primary btn-sm mt-1 ms-2" href="/register">Регистрация</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <main class="container py-4">
    <%- include(content) %>
  </main>

  <footer class="border-top py-4 mt-4 bg-white">
    <div class="container text-muted small">
      ПомогиСемьям — платформа взаимопомощи семьям с детьми до 18 лет.
      Все данные в этом демо-прототипе хранятся в памяти сервера.
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
