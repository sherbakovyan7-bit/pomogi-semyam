<%
const urgencyBadge = { critical: 'bg-danger', high: 'bg-warning', medium: 'bg-primary', low: 'bg-secondary' };
%>
<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
  <div>
    <h1 class="mb-1">Нужды семей</h1>
    <p class="text-muted mb-0">Семьи с детьми до 18 лет публикуют свои просьбы — благотворители отвечают на них личными сообщениями.</p>
  </div>
  <% if (user && user.role === 'family') { %>
    <a href="/need/new" class="btn btn-primary btn-lg">+ Подать нужду</a>
  <% } %>
</div>

<form method="get" action="/" class="row g-2 mb-4">
  <div class="col-auto">
    <select name="category" class="form-select">
      <option value="">Все категории</option>
      <% categories.forEach(c => { %>
        <option value="<%= c %>" <%= category === c ? 'selected' : '' %>><%= c %></option>
      <% }); %>
    </select>
  </div>
  <div class="col-auto">
    <select name="urgency" class="form-select">
      <option value="">Любая срочность</option>
      <option value="critical" <%= urgency === 'critical' ? 'selected' : '' %>>Критично</option>
      <option value="high" <%= urgency === 'high' ? 'selected' : '' %>>Высокая</option>
      <option value="medium" <%= urgency === 'medium' ? 'selected' : '' %>>Средняя</option>
      <option value="low" <%= urgency === 'low' ? 'selected' : '' %>>Не срочно</option>
    </select>
  </div>
  <div class="col-auto">
    <button class="btn btn-outline-primary" type="submit">Фильтровать</button>
  </div>
</form>

<% if (needs.length === 0) { %>
  <div class="alert alert-light border">Пока нет нужд по выбранным фильтрам.</div>
<% } %>

<div class="row g-3">
  <% needs.forEach(n => {
    const author = db.users.find(u => u.id === n.userId);
  %>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 need-card">
        <div class="card-body d-flex flex-column">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="badge <%= urgencyBadge[n.urgency] %>"><%= URGENCY[n.urgency] %></span>
            <span class="text-muted small"><%= n.category %></span>
          </div>
          <h5 class="card-title"><a href="/need/<%= n.id %>" class="text-decoration-none text-dark"><%= n.title %></a></h5>
          <p class="card-text text-muted small flex-grow-1"><%= n.description.length > 140 ? n.description.slice(0, 140) + '…' : n.description %></p>
          <div class="d-flex justify-content-between align-items-center mt-2">
            <span class="text-muted small"><%= author ? author.username : 'Аноним' %> · <%= formatDate(n.createdAt) %></span>
            <a href="/need/<%= n.id %>" class="btn btn-sm btn-outline-primary">Подробнее</a>
          </div>
        </div>
      </div>
    </div>
  <% }); %>
</div>
